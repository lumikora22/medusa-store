# Local development example. Use a unique value in every environment.
DJANGO_SECRET_KEY=replace-with-local-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Default: sqlite. Set DB_ENGINE=postgres to use the docker-compose PostgreSQL service.
DB_ENGINE=sqlite
POSTGRES_DB=medusa_store
POSTGRES_USER=medusa
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Comma-separated origins. Add your phone/LAN Expo origin here for physical-device testing.
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://127.0.0.1:19006
